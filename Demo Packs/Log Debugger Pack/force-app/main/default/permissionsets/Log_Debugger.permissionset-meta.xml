<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Log Debugger</label>
    <description
  >Access to the Log Debugger component: its Apex pipeline and the Case field the analysis is written to.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>LogClaudeService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LogKnowledgeSearch</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LogAnalysis</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LogDebuggerController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LogDistiller</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <editable>true</editable>
        <field>Case.Log_Analysis__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!--
      Read on every Knowledge field the retrieval touches. LogKnowledgeSearch
      queries WITH USER_MODE, and a field the running user cannot read comes back
      as "No such column", not as a permissions error, so a gap here looks like a
      broken query. An admin never sees it, because admins bypass field-level
      security; a rep on a service profile does.
    -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Knowledge__kav.External_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Knowledge__kav.KCSArticle_Issue__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Knowledge__kav.KCSArticle_Cause__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Knowledge__kav.KCSArticle_Environment__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Knowledge__kav.KCSArticle_Resolution__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
